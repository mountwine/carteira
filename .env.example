# Optional public endpoint override. Leave blank to use same-origin /api/places.
VITE_PLACES_ENDPOINT=
# Required only to enable online place search. Server-side only; never VITE_.
# GEOAPIFY_API_KEY=
# Exact browser origin, with scheme and host, no path or trailing slash.
# ALLOWED_ORIGIN=http://localhost:5173
# Login por código de e-mail (opcional). Valores públicos do projeto Supabase
# (Project URL e chave anon/publishable). Nunca use a chave service_role.
# Sem eles, o app mantém o login local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
